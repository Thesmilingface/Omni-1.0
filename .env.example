# Copy to .env for local development. Never commit real credentials.
SMERKA_PROVIDER=groq
SMERKA_MODEL=llama-3.3-70b-versatile
SMERKA_API_BASE=https://api.groq.com/openai/v1
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
SMERKA_TIMEOUT_SECONDS=45
SMERKA_DATABASE_PATH=./data/smerka.sqlite3
SMERKA_ALLOWED_WORKSPACE=./workspace
# Optional web search integration is not configured by default.
BRAVE_SEARCH_API_KEY=
FISH_AUDIO_API_KEY=
FISH_AUDIO_VOICE_ID=
